# Credenciales para "npm run deploy". Copiar este archivo como .env.deploy
# (que no se sube a GitHub) y completar la contraseña.
#
# La cuenta FTP se crea en cPanel → Cuentas FTP, con el directorio public_html.
FTP_HOST=pyme117.pymedns.net
FTP_USER=deploy@dataorbit.cl
FTP_PASSWORD=
# Carpeta de destino dentro de la cuenta FTP. Si la cuenta apunta a public_html, es "/".
FTP_DIR=/
