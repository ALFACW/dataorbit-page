# .htaccess de public_html (hosting cPanel de dataorbit.cl)
#
# OJO: en public_html también viven carpetas de subdominios en producción
# (mowi.dataorbit.cl, api.dataorbit.cl), y este archivo les aplica. Por eso:
#   - Todo lo que venía del .htaccess del WordPress (compresión, caché, bloqueos,
#     manejador de PHP de cPanel) se conserva igual y sigue aplicando a todos.
#   - Las reglas del sitio nuevo solo aplican a dataorbit.cl y www.
#   - Para cualquier otro host se mantiene la regla de respaldo que tenía WordPress.
# El original quedó en deploy/htaccess-wordpress-original.txt.

<IfModule mod_deflate.c>SetOutputFilter DEFLATE
<IfModule mod_setenvif.c>
<IfModule mod_headers.c>
SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
RequestHeader append Accept-Encoding 'gzip,deflate' env=HAVE_Accept-Encoding
SetEnvIfNoCase Request_URI \
\.(?:gif|jpe?g|png|rar|zip|exe|flv|mov|wma|mp3|avi|swf|mp?g|mp4|webm|webp)$ no-gzip dont-vary
</IfModule>
</IfModule>

<IfModule mod_filter.c>
AddOutputFilterByType DEFLATE application/atom+xml \
application/javascript \
application/json \
application/rss+xml \
application/vnd.ms-fontobject \
application/x-font-ttf \
application/xhtml+xml \
application/xml \
font/opentype \
image/svg+xml \
image/x-icon \
text/css \
text/html \
text/plain \
text/x-component \
text/xml
</IfModule>
<IfModule mod_headers.c>
Header append Vary: Accept-Encoding
</IfModule>
</IfModule>

<IfModule mod_mime.c>
AddType text/html .html_gzip
AddEncoding gzip .html_gzip
</IfModule>
<IfModule mod_setenvif.c>
SetEnvIfNoCase Request_URI \.html_gzip$ no-gzip
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault A2592000
ExpiresByType application/javascript 'access plus 30 days'
ExpiresByType text/javascript 'access plus 30 days'
ExpiresByType text/css 'access plus 30 days'
ExpiresByType image/jpeg 'access plus 30 days'
ExpiresByType image/png 'access plus 30 days'
ExpiresByType image/gif 'access plus 30 days'
ExpiresByType image/ico 'access plus 30 days'
ExpiresByType image/x-icon 'access plus 30 days'
ExpiresByType image/svg+xml 'access plus 30 days'
ExpiresByType image/bmp 'access plus 30 days'
</IfModule>
Options -Indexes
ErrorDocument 403 /

<FilesMatch '^.*(error_log|wp-config.php|php.ini|.[hH][tT][aApP].*)$'>
Order deny,allow
Deny from all
</FilesMatch>
<files wp-config.php>
order allow,deny
deny from all
</files>

# Credenciales y secretos: nunca se sirven por web, en ninguna carpeta de public_html
# (por ejemplo api.dataorbit.cl/mowi-credentials.json quedaba descargable). Los
# programas que los usan los leen directo del disco, así que esto no los afecta.
<FilesMatch "(?i)(credential|secret|\.env|\.pem$|\.key$|\.p12$)">
Order allow,deny
Deny from all
</FilesMatch>

<Files robots.txt>
Allow from all
</Files>

<Files ads.txt>
Allow from all
</Files>

# Sitio principal: el HTML no se guarda en caché (la regla de 30 días de arriba
# haría que una actualización tarde un mes en verse). Los JS y CSS llevan un hash
# en el nombre y sí se cachean. Solo aplica con la marca de dataorbit.cl y www.
<IfModule mod_setenvif.c>
SetEnvIfNoCase Host ^(www\.)?dataorbit\.cl$ SITIO_PRINCIPAL
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache" env=SITIO_PRINCIPAL
</FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# --- Sitio principal (dataorbit.cl y www). Cada regla lleva su condición de host. ---

# Forzar HTTPS
RewriteCond %{HTTP_HOST} ^(www\.)?dataorbit\.cl$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://dataorbit.cl/$1 [R=301,L]

# www a sin www (versión canónica única)
RewriteCond %{HTTP_HOST} ^www\.dataorbit\.cl$ [NC]
RewriteRule ^(.*)$ https://dataorbit.cl/$1 [R=301,L]

# Rutas del WordPress antiguo
RewriteCond %{HTTP_HOST} ^dataorbit\.cl$ [NC]
RewriteRule ^eduorbit-360/?$ /eduorbit [R=301,L]
RewriteCond %{HTTP_HOST} ^dataorbit\.cl$ [NC]
RewriteRule ^servicios/?$ /#soluciones [R=301,NE,L]
RewriteCond %{HTTP_HOST} ^dataorbit\.cl$ [NC]
RewriteRule ^contacto/?$ /#contacto [R=301,NE,L]
RewriteCond %{HTTP_HOST} ^dataorbit\.cl$ [NC]
RewriteRule ^(feed|comments/feed|wp-login\.php|xmlrpc\.php)/?$ / [R=301,L]

# Rutas de la aplicación (React): todo lo que no es un archivo real va a app.html.
# index.html trae el home pre-renderizado; app.html es la página vacía para el resto.
RewriteCond %{HTTP_HOST} ^dataorbit\.cl$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /app.html [L]

# --- Cualquier otro host (subdominios en carpetas de public_html): igual que con WordPress ---
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Configure el paquete “ea-php81” como el lenguaje de programación predeterminado “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
